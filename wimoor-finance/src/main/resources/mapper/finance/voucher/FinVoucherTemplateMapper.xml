<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wimoor.finance.voucher.mapper.FinVoucherTemplateMapper">

    <resultMap type="com.wimoor.finance.voucher.domain.FinVoucherTemplate" id="FinVoucherTemplateResult">
        <result property="id"    column="id"    />
        <result property="groupid"    column="groupid"    />
        <result property="typeId"    column="type_id"    />
        <result property="name"    column="name"    />
        <result property="createBy"    column="create_by"    />
        <result property="modifyBy"    column="modify_by"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedTime"    column="updated_time"    />
    </resultMap>

    <resultMap type="com.wimoor.finance.voucher.domain.FinVoucherTemplate" id="FinVoucherTemplateWithNameResult">
        <result property="id"    column="id"    />
        <result property="groupid"    column="groupid"    />
        <result property="typeId"    column="type_id"    />
        <result property="name"    column="name"    />
        <result property="typeName"    column="type_name"    />
        <result property="createBy"    column="create_by"    />
        <result property="modifyBy"    column="modify_by"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedTime"    column="updated_time"    />
    </resultMap>

    <sql id="selectFinVoucherTemplateVo">
        select id, groupid, type_id, name, create_by, modify_by, created_time, updated_time from fin_vouchers_template
    </sql>

    <select id="selectFinVoucherTemplateList" parameterType="com.wimoor.finance.voucher.domain.FinVoucherTemplate" resultMap="FinVoucherTemplateWithNameResult">
        select t.id, t.groupid, t.type_id, t.name, ty.name as type_name,
               t.create_by, t.modify_by, t.created_time, t.updated_time
        from fin_vouchers_template t
        left join fin_vouchers_template_type ty on t.type_id = ty.id
        <where>
            <if test="name != null and name != ''"> and t.name like concat('%', #{name}, '%')</if>
            <if test="groupid != null"> and t.groupid = #{groupid}</if>
            <if test="typeId != null"> and t.type_id = #{typeId}</if>
        </where>
        order by t.created_time desc
    </select>

    <select id="selectFinVoucherTemplateById" parameterType="Long" resultMap="FinVoucherTemplateResult">
        <include refid="selectFinVoucherTemplateVo"/>
        where id = #{id}
    </select>

    <insert id="insertFinVoucherTemplate" parameterType="com.wimoor.finance.voucher.domain.FinVoucherTemplate" useGeneratedKeys="true" keyProperty="id">
        insert into fin_vouchers_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="groupid != null">groupid,</if>
            <if test="typeId != null">type_id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="modifyBy != null and modifyBy != ''">modify_by,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="updatedTime != null">updated_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="groupid != null">#{groupid},</if>
            <if test="typeId != null">#{typeId},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="modifyBy != null and modifyBy != ''">#{modifyBy},</if>
            <if test="createdTime != null">#{createdTime},</if>
            <if test="updatedTime != null">#{updatedTime},</if>
        </trim>
    </insert>

    <update id="updateFinVoucherTemplate" parameterType="com.wimoor.finance.voucher.domain.FinVoucherTemplate">
        update fin_vouchers_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="typeId != null">type_id = #{typeId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="modifyBy != null and modifyBy != ''">modify_by = #{modifyBy},</if>
            <if test="updatedTime != null">updated_time = #{updatedTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFinVoucherTemplateById" parameterType="Long">
        delete from fin_vouchers_template where id = #{id}
    </delete>

    <delete id="deleteFinVoucherTemplateByIds" parameterType="Long">
        delete from fin_vouchers_template where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
