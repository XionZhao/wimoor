<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wimoor.finance.voucher.mapper.FinVoucherTemplateEntriesMapper">

    <resultMap type="com.wimoor.finance.voucher.domain.FinVoucherTemplateEntries" id="FinVoucherTemplateEntriesResult">
        <result property="entryId"    column="entry_id"    />
        <result property="groupid"    column="groupid"    />
        <result property="templateId"    column="template_id"    />
        <result property="entryNo"    column="entry_no"    />
        <result property="subjectId"    column="subject_id"    />
        <result property="summary"    column="summary"    />
        <result property="debitAmount"    column="debit_amount"    />
        <result property="creditAmount"    column="credit_amount"    />
        <result property="originalAmount"    column="original_amount"    />
        <result property="currency"    column="currency"    />
        <result property="exchangeRate"    column="exchange_rate"    />
        <result property="quantity"    column="quantity"    />
        <result property="unitPrice"    column="unit_price"    />
        <result property="createdTime"    column="created_time"    />
    </resultMap>

    <resultMap type="com.wimoor.finance.voucher.domain.FinVoucherTemplateEntries" id="FinVoucherTemplateEntriesWithSubjectResult">
        <result property="entryId"    column="entry_id"    />
        <result property="groupid"    column="groupid"    />
        <result property="templateId"    column="template_id"    />
        <result property="entryNo"    column="entry_no"    />
        <result property="subjectId"    column="subject_id"    />
        <result property="subjectCode"    column="subject_code"    />
        <result property="subjectName"    column="subject_name"    />
        <result property="summary"    column="summary"    />
        <result property="debitAmount"    column="debit_amount"    />
        <result property="creditAmount"    column="credit_amount"    />
        <result property="originalAmount"    column="original_amount"    />
        <result property="currency"    column="currency"    />
        <result property="exchangeRate"    column="exchange_rate"    />
        <result property="quantity"    column="quantity"    />
        <result property="unitPrice"    column="unit_price"    />
        <result property="createdTime"    column="created_time"    />
    </resultMap>

    <sql id="selectFinVoucherTemplateEntriesVo">
        select entry_id, groupid, template_id, entry_no, subject_id, summary, debit_amount, credit_amount,
               original_amount, currency, exchange_rate, quantity, unit_price, created_time
        from fin_vouchers_template_entries
    </sql>

    <select id="selectFinVoucherTemplateEntriesById" parameterType="Long" resultMap="FinVoucherTemplateEntriesResult">
        <include refid="selectFinVoucherTemplateEntriesVo"/>
        where entry_id = #{entryId}
    </select>

    <select id="selectByTemplateId" parameterType="Long" resultMap="FinVoucherTemplateEntriesWithSubjectResult">
        select e.entry_id, e.groupid, e.template_id, e.entry_no, e.subject_id,
               s.subject_code, s.subject_name,
               e.summary, e.debit_amount, e.credit_amount,
               e.original_amount, e.currency, e.exchange_rate,
               e.quantity, e.unit_price, e.created_time
        from fin_vouchers_template_entries e
        left join fin_accounting_subjects s on e.subject_id = s.subject_id and e.groupid = s.groupid
        where e.template_id = #{templateId}
        order by e.entry_no
    </select>

    <insert id="insertFinVoucherTemplateEntries" parameterType="com.wimoor.finance.voucher.domain.FinVoucherTemplateEntries" useGeneratedKeys="true" keyProperty="entryId">
        insert into fin_vouchers_template_entries
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="groupid != null">groupid,</if>
            <if test="templateId != null">template_id,</if>
            <if test="entryNo != null">entry_no,</if>
            <if test="subjectId != null">subject_id,</if>
            <if test="summary != null and summary != ''">summary,</if>
            <if test="debitAmount != null">debit_amount,</if>
            <if test="creditAmount != null">credit_amount,</if>
            <if test="originalAmount != null">original_amount,</if>
            <if test="currency != null and currency != ''">currency,</if>
            <if test="exchangeRate != null">exchange_rate,</if>
            <if test="quantity != null">quantity,</if>
            <if test="unitPrice != null">unit_price,</if>
            <if test="createdTime != null">created_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="groupid != null">#{groupid},</if>
            <if test="templateId != null">#{templateId},</if>
            <if test="entryNo != null">#{entryNo},</if>
            <if test="subjectId != null">#{subjectId},</if>
            <if test="summary != null and summary != ''">#{summary},</if>
            <if test="debitAmount != null">#{debitAmount},</if>
            <if test="creditAmount != null">#{creditAmount},</if>
            <if test="originalAmount != null">#{originalAmount},</if>
            <if test="currency != null and currency != ''">#{currency},</if>
            <if test="exchangeRate != null">#{exchangeRate},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="unitPrice != null">#{unitPrice},</if>
            <if test="createdTime != null">#{createdTime},</if>
        </trim>
    </insert>

    <update id="updateFinVoucherTemplateEntries" parameterType="com.wimoor.finance.voucher.domain.FinVoucherTemplateEntries">
        update fin_vouchers_template_entries
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateId != null">template_id = #{templateId},</if>
            <if test="entryNo != null">entry_no = #{entryNo},</if>
            <if test="subjectId != null">subject_id = #{subjectId},</if>
            <if test="summary != null and summary != ''">summary = #{summary},</if>
            <if test="debitAmount != null">debit_amount = #{debitAmount},</if>
            <if test="creditAmount != null">credit_amount = #{creditAmount},</if>
            <if test="originalAmount != null">original_amount = #{originalAmount},</if>
            <if test="currency != null and currency != ''">currency = #{currency},</if>
            <if test="exchangeRate != null">exchange_rate = #{exchangeRate},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="unitPrice != null">unit_price = #{unitPrice},</if>
        </trim>
        where entry_id = #{entryId}
    </update>

    <delete id="deleteFinVoucherTemplateEntriesById" parameterType="Long">
        delete from fin_vouchers_template_entries where entry_id = #{entryId}
    </delete>

    <delete id="deleteByTemplateId" parameterType="Long">
        delete from fin_vouchers_template_entries where template_id = #{templateId}
    </delete>

    <insert id="insertBatch" parameterType="java.util.List">
        insert into fin_vouchers_template_entries (groupid, template_id, entry_no, subject_id, summary, debit_amount, credit_amount,
            original_amount, currency, exchange_rate, quantity, unit_price, created_time) values
        <foreach item="item" collection="list" separator=",">
            (#{item.groupid}, #{item.templateId}, #{item.entryNo}, #{item.subjectId}, #{item.summary},
             #{item.debitAmount}, #{item.creditAmount}, #{item.originalAmount}, #{item.currency},
             #{item.exchangeRate}, #{item.quantity}, #{item.unitPrice}, #{item.createdTime})
        </foreach>
    </insert>
</mapper>
