<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wimoor.finance.ledger.mapper.FinInvoiceExtensionMapper">

    <resultMap type="com.wimoor.finance.ledger.domain.FinInvoiceExtension" id="FinInvoiceExtensionResult">
        <result property="id"           column="id" />
        <result property="invoiceId"    column="invoice_id" />
        <result property="businessType" column="business_type" />
        <result property="attrKey"      column="attr_key" />
        <result property="attrValue"    column="attr_value" />
        <result property="createdTime"  column="created_time" />
    </resultMap>

    <select id="selectByInvoiceId" parameterType="Long" resultMap="FinInvoiceExtensionResult">
        select * from fin_invoice_extension where invoice_id = #{invoiceId}
    </select>

    <insert id="batchInsert" parameterType="java.util.List">
        insert into fin_invoice_extension (invoice_id, business_type, attr_key, attr_value)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.invoiceId}, #{item.businessType}, #{item.attrKey}, #{item.attrValue})
        </foreach>
    </insert>

    <delete id="deleteByInvoiceId" parameterType="Long">
        delete from fin_invoice_extension where invoice_id = #{invoiceId}
    </delete>

</mapper>
