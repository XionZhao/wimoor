<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wimoor.finance.setting.mapper.FinMappingVouchersSourceMapper">

    <resultMap type="com.wimoor.finance.setting.domain.FinMappingVouchersSource" id="FinMappingVouchersSourceResult">
        <result property="id"            column="id"            />
        <result property="groupid"       column="groupid"       />
        <result property="orderId"       column="order_id"      />
        <result property="orderNumber"   column="order_number"  />
        <result property="sku"           column="sku"           />
        <result property="warehouseName" column="warehouse_name"/>
        <result property="supplierName"  column="supplier_name" />
        <result property="totalAmount"   column="total_amount"  />
        <result property="voucherType"  column="voucher_type"  />
        <result property="voucherId"     column="voucher_id"    />
        <result property="voucherWord"   column="v_word"        />
        <result property="voucherNumber" column="v_number"      />
        <result property="syncStatus"    column="sync_status"   />
        <result property="dataHash"      column="data_hash"     />
        <result property="syncTime"      column="sync_time"     />
        <result property="createdTime"   column="created_time"  />
        <result property="updatedTime"   column="updated_time"  />
        <result property="createBy"      column="create_by"     />
        <result property="updateBy"      column="modify_by"     />
    </resultMap>

    <sql id="selectFinMappingVouchersSourceVo">
        select e.id, e.groupid, e.order_id, e.order_number, e.sku, e.warehouse_name, e.supplier_name,
               e.total_amount, e.voucher_type, e.voucher_id, e.sync_status, e.data_hash, e.sync_time,
               e.created_time, e.updated_time, e.create_by, e.modify_by,
               v.voucher_type as v_word, v.voucher_no as v_number
        from fin_mapping_vouchers_source e
        left join fin_vouchers v on e.voucher_id = v.voucher_id
    </sql>

    <select id="selectFinMappingVouchersSourceList" parameterType="com.wimoor.finance.setting.domain.FinMappingVouchersSource" resultMap="FinMappingVouchersSourceResult">
        <include refid="selectFinMappingVouchersSourceVo"/>
        <where>
            <if test="groupid != null and groupid != ''"> and e.groupid = #{groupid}</if>
            <if test="orderId != null and orderId != ''"> and e.order_id = #{orderId}</if>
            <if test="voucherType != null and voucherType != ''"> and e.voucher_type = #{voucherType}</if>
            <if test="syncStatus != null"> and e.sync_status = #{syncStatus}</if>
            <if test="voucherId != null"> and e.voucher_id = #{voucherId}</if>
        </where>
    </select>

    <select id="selectFinMappingVouchersSourceById" parameterType="Long" resultMap="FinMappingVouchersSourceResult">
        <include refid="selectFinMappingVouchersSourceVo"/>
        where e.id = #{id}
    </select>

    <select id="selectByOrderId" resultMap="FinMappingVouchersSourceResult">
        <include refid="selectFinMappingVouchersSourceVo"/>
        where e.groupid = #{param1} and e.order_id = #{param2}
    </select>

    <select id="selectByOrderIds" resultMap="FinMappingVouchersSourceResult">
        <include refid="selectFinMappingVouchersSourceVo"/>
        where e.groupid = #{param1}
        and e.order_id in
        <foreach item="item" collection="param2" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

    <insert id="insertFinMappingVouchersSource" parameterType="com.wimoor.finance.setting.domain.FinMappingVouchersSource" useGeneratedKeys="true" keyProperty="id">
        insert into fin_mapping_vouchers_source
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="groupid != null and groupid != ''">groupid,</if>
            <if test="orderId != null and orderId != ''">order_id,</if>
            <if test="orderNumber != null">order_number,</if>
            <if test="sku != null and sku != ''">sku,</if>
            <if test="warehouseName != null">warehouse_name,</if>
            <if test="supplierName != null">supplier_name,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="voucherType != null">voucher_type,</if>
            <if test="voucherId != null">voucher_id,</if>
            <if test="syncStatus != null">sync_status,</if>
            <if test="dataHash != null">data_hash,</if>
            <if test="syncTime != null">sync_time,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="updatedTime != null">updated_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">modify_by,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="groupid != null and groupid != ''">#{groupid},</if>
            <if test="orderId != null and orderId != ''">#{orderId},</if>
            <if test="orderNumber != null">#{orderNumber},</if>
            <if test="sku != null and sku != ''">#{sku},</if>
            <if test="warehouseName != null">#{warehouseName},</if>
            <if test="supplierName != null">#{supplierName},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="voucherType != null">#{voucherType},</if>
            <if test="voucherId != null">#{voucherId},</if>
            <if test="syncStatus != null">#{syncStatus},</if>
            <if test="dataHash != null">#{dataHash},</if>
            <if test="syncTime != null">#{syncTime},</if>
            <if test="createdTime != null">#{createdTime},</if>
            <if test="updatedTime != null">#{updatedTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
        </trim>
    </insert>

    <update id="updateFinMappingVouchersSource" parameterType="com.wimoor.finance.setting.domain.FinMappingVouchersSource">
        update fin_mapping_vouchers_source
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNumber != null">order_number = #{orderNumber},</if>
            <if test="warehouseName != null">warehouse_name = #{warehouseName},</if>
            <if test="supplierName != null">supplier_name = #{supplierName},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="voucherType != null">voucher_type = #{voucherType},</if>
            voucher_id = #{voucherId},
            <if test="syncStatus != null">sync_status = #{syncStatus},</if>
            <if test="dataHash != null">data_hash = #{dataHash},</if>
            <if test="syncTime != null">sync_time = #{syncTime},</if>
            <if test="updatedTime != null">updated_time = #{updatedTime},</if>
            <if test="updateBy != null">modify_by = #{updateBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFinMappingVouchersSourceById" parameterType="Long">
        delete from fin_mapping_vouchers_source where id = #{id}
    </delete>

</mapper>
