<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wimoor.finance.setting.mapper.FinMappingErpAccountMapper">
<!--    CREATE TABLE `fin_mapping_erp_account` (-->
<!--    `id` BIGINT(20) UNSIGNED NOT NULL,-->
<!--    `groupid` BIGINT(20) UNSIGNED NULL DEFAULT NULL,-->
<!--    `fee_type_id` BIGINT(20) UNSIGNED NULL DEFAULT NULL,-->
<!--    `subject_id` BIGINT(20) UNSIGNED NULL DEFAULT NULL,-->
<!--    PRIMARY KEY (`id`) USING BTREE,-->
<!--    INDEX `groupid` (`groupid`) USING BTREE-->
<!--    )-->
<!--    COLLATE='utf8mb4_bin'-->
<!--    ENGINE=InnoDB-->
<!--    ;-->

    <resultMap type="com.wimoor.finance.setting.domain.FinMappingErpAccount" id="FinMappingErpAccountResult">
        <result property="id"    column="id"    />
        <result property="groupid"    column="groupid"    />
        <result property="feeTypeId"    column="fee_type_id"    />
        <result property="subjectId"    column="subject_id"    />
        <result property="subjectName"    column="subject_name"    />
    </resultMap>

    <sql id="selectFinMappingErpAccountVo">
        select r.id, r.groupid, r.fee_type_id, r.subject_id,
               concat(s.subject_code, ' ', s.subject_name) as subject_name
        from fin_mapping_erp_account r
        left join fin_accounting_subjects s on r.subject_id = s.subject_id
    </sql>

    <select id="selectFinMappingErpAccountList" parameterType="com.wimoor.finance.setting.domain.FinMappingErpAccount" resultMap="FinMappingErpAccountResult">
        <include refid="selectFinMappingErpAccountVo"/>
        <where>
            and r.groupid = #{groupid}
            <if test="feeTypeId != null"> and r.fee_type_id = #{feeTypeId}</if>
            <if test="subjectId != null"> and r.subject_id = #{subjectId}</if>
        </where>
        order by r.id desc
    </select>

    <select id="selectFinMappingErpAccountById" parameterType="Long" resultMap="FinMappingErpAccountResult">
        <include refid="selectFinMappingErpAccountVo"/>
        where r.id = #{id}
    </select>

    <insert id="insertFinMappingErpAccount" parameterType="com.wimoor.finance.setting.domain.FinMappingErpAccount">
        insert into fin_mapping_erp_account
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="groupid != null">groupid,</if>
            <if test="feeTypeId != null">fee_type_id,</if>
            <if test="subjectId != null">subject_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="groupid != null">#{groupid},</if>
            <if test="feeTypeId != null">#{feeTypeId},</if>
            <if test="subjectId != null">#{subjectId},</if>
        </trim>
    </insert>

    <update id="updateFinMappingErpAccount" parameterType="com.wimoor.finance.setting.domain.FinMappingErpAccount">
        update fin_mapping_erp_account
        <trim prefix="SET" suffixOverrides=",">
            <if test="groupid != null">groupid = #{groupid},</if>
            <if test="feeTypeId != null">fee_type_id = #{feeTypeId},</if>
            <if test="subjectId != null">subject_id = #{subjectId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFinMappingErpAccountById" parameterType="Long">
        delete from fin_mapping_erp_account where id = #{id}
    </delete>

    <delete id="deleteFinMappingErpAccountByIds" parameterType="String">
        delete from fin_mapping_erp_account where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
