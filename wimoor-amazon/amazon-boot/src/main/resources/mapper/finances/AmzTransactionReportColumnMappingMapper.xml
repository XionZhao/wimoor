<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wimoor.amazon.finances.mapper.AmzTransactionReportColumnMappingMapper">

    <resultMap id="BaseResultMap" type="com.wimoor.amazon.finances.pojo.entity.AmzTransactionReportColumnMapping">
        <id property="id" column="id"/>
        <result property="marketplaceid" column="marketplaceid"/>
        <result property="fieldName" column="field_name"/>
        <result property="columnName" column="column_name"/>
    </resultMap>

    <select id="selectByMarketplaceId" resultMap="BaseResultMap">
        SELECT id, marketplaceid, field_name, column_name
        FROM t_amz_transaction_report_column_mapping
        WHERE marketplaceid = #{marketplaceid}
    </select>

</mapper>