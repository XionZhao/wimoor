                                              }
                                 },
                      "required":  [
                                       "name"
                                   ],
                      "response_fields":  {
                                              "data":  "保存结果"
                                          }
                  },
                  {
                      "name":  "project_update",
                      "description":  "更新财务项目名称",
                      "menu_id":  1012188,
                      "endpoint":  "/erp/api/v1/fin/project/updateProject",
                      "method":  "GET",
                      "params":  {
                                     "id":  {
                                                "type":  "string",
                                                "description":  "项目ID"
                                            },
                                     "name":  {
