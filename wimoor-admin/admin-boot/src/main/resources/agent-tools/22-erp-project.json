                                              }
                                 },
                      "required":  [
                                       "id",
                                       "name"
                                   ],
                      "response_fields":  {
                                              "data":  "更新结果"
                                          }
                  },
                  {
                      "name":  "project_delete",
                      "description":  "删除财务项目",
                      "menu_id":  1012188,
                      "endpoint":  "/erp/api/v1/fin/project/delProject",
                      "method":  "GET",
                      "params":  {
                                     "id":  {
