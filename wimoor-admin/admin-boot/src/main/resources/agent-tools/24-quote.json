{
    "module":  "报价模块",
    "description":  "报价单管理，包括报价订单、发货单、供应商报价、采购报价、物流渠道等查询。所有接口需要token认证（买家/供应商令牌）",
    "tools":  [
                  {
                      "name":  "quote_order_list",
                      "description":  "查询报价订单列表，返回分页的订单数据，支持按状态、关键词、日期范围筛选",
                      "menu_id":  1211,
                      "endpoint":  "/quote/api/v1/quote/listOrder",
                      "method":  "POST",
                      "service":  "wimoor-quote",
                      "body":  {
                                   "token":  {
                                                 "type":  "string",
                                                 "description":  "买家令牌（必填）"
                                             },
                                   "status":  {
                                                  "type":  "integer",
                                                  "description":  "订单状态：1-等待确认, 2-等待拼团, 3-等待报价, 4-结束, 0或不传-全部"
                                              },
                                   "search":  {
                                                  "type":  "string",
                                                  "description":  "关键字搜索（订单号、备注、供应商名、货件名、目的地、国家、SKU等）"
                                              },
                                   "fromDate":  {
                                                    "type":  "string",
                                                    "description":  "开始日期，格式：yyyy-MM-dd"
                                                },
                                   "toDate":  {
                                                  "type":  "string",
                                                  "description":  "结束日期，格式：yyyy-MM-dd"
                                              },
                                   "currentpage":  {
                                                       "type":  "integer",
                                                       "description":  "页码，默认1"
                                                   },
                                   "pagesize":  {
                                                    "type":  "integer",
                                                    "description":  "每页数量，默认1000"
                                                }
                               },
                      "required":  [
                                       "token"
                                   ],
                      "response_fields":  {
                                              "id":  "订单ID",
                                              "buyerid":  "买家ID",
                                              "ftype":  "订单类型",
                                              "isgroupbuy":  "是否拼团",
                                              "isbidding":  "是否竞价",
                                              "status":  "订单状态(1-等待确认,2-等待拼团,3-等待报价,4-结束,5-已关闭)",
                                              "weight":  "订单重量",
                                              "volume":  "订单体积",
                                              "closetime":  "订单关闭时间",
                                              "pricetime":  "报价接受时间",
                                              "createtime":  "创建时间",
                                              "remark":  "备注",
                                              "number":  "订单编号",
                                              "transchannel":  "物流渠道ID",
                                              "days":  "到货时效",
                                              "shipmentList":  "关联货件列表",
                                              "addressList":  "地址列表",
                                              "quotationPriceList":  "报价列表"
                                          }
                  },
