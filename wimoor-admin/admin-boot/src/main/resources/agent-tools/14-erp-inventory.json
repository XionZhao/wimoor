                  {
                      "name":  "inv_list",
                      "description":  "查询ERP库存列表，支持按SKU、仓库、产品名称等条件筛选，返回各仓库的库存数量、可用库存、待入库、待出库等信息",
                      "menu_id":  50,
                      "endpoint":  "/erp/api/v1/inventory/getWarehouse",
                      "method":  "POST",
                      "params":  {
                                     "search":  {
                                                 "type":  "string",
                                                 "description":  "搜索关键词，支持按SKU或产品名称搜索"
                                             },
                                     "warehouseid":  {
                                                         "type":  "string",
                                                         "description":  "仓库ID，不传则返回所有仓库的库存汇总"
                                                     },
                                     "category":  {
                                                      "type":  "string",
                                                      "description":  "产品分类ID"
                                                  },
                                     "ftypes":  {
                                                   "type":  "string",
                                                   "description":  "产品类型：''(全部)、'0'(成品)、'1'(半成品)、'2'(配件)"
                                               },
                                     "groupid":  {
                                                     "type":  "string",
                                                     "description":  "店铺分组ID"
                                                 },
                                     "supplierid":  {
                                                        "type":  "string",
                                                        "description":  "供应商ID"
                                                    },
                                     "islike":  {
                                                    "type":  "boolean",
                                                    "description":  "是否模糊搜索，默认true"
                                                },
                                     "notlike":  {
                                                    "type":  "boolean",
                                                    "description":  "是否精确查询，默认false"
                                                },
                                     "hasinv":  {
                                                    "type":  "boolean",
                                                    "description":  "是否只查看有库存产品，默认false"
                                                },
                                     "itemsku":  {
                                                    "type":  "string",
                                                    "description":  "子产品SKU编码"
                                                },
                                     "conssku":  {
                                                    "type":  "string",
                                                    "description":  "辅料SKU编码"
                                                },
                                     "currentpage":  {
                                                         "type":  "integer",
                                                         "description":  "页码，默认1"
                                                     },
                                     "pagesize":  {
                                                      "type":  "integer",
                                                      "description":  "每页数量，默认20"
                                                  }
                                 },
                      "required":  [

                                   ],
                      "default_params":  {
                                             "islike":  true
                                         },
                      "response_fields":  {
                                              "sku":  "产品SKU编码",
                                              "name":  "产品名称",
                                              "warehouse":  "仓库名称",
                                              "warehousename":  "仓库名称",
                                              "warehouseid":  "仓库ID",
                                              "materialid":  "产品物料ID",
                                              "fulfillable":  "可用库存数量",
                                              "inbound":  "待入库数量",
                                              "outbound":  "待出库数量",
                                              "price":  "产品单价",
                                              "issfg":  "产品类型标识",
                                              "supplier":  "供应商名称",
                                              "allinbound":  "待入库汇总（首页第一条记录）",
