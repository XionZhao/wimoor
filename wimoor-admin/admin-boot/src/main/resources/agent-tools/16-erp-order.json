{
    "module":  "ERP订单管理",
    "description":  "ERP多平台订单查询、订单详情、订单计划、销售明细、订单发票等订单全生命周期管理",
    "service":  "wimoor-erp",
    "tools":  [
                  {
                      "name":  "order_list",
                      "description":  "查询ERP多平台订单列表（SKU维度），支持按平台、状态、日期范围、SKU等条件筛选",
                      "menu_id":  8,
                      "endpoint":  "/erp/api/v1/order/findByCondition",
                      "method":  "POST",
                      "params":  {
                                     "paramother":  {
                                                        "type":  "object",
                                                        "description":  "查询参数对象，包含以下字段"
                                                    },
                                     "paramother.sku":  {
                                                            "type":  "string",
                                                            "description":  "搜索关键词，支持SKU"
                                                        },
                                     "paramother.platformid":  {
                                                                   "type":  "string",
                                                                   "description":  "平台ID"
                                                               },
                                     "paramother.warehouseid":  {
                                                                    "type":  "string",
                                                                    "description":  "仓库ID"
                                                                },
                                     "paramother.ischeck":  {
                                                                "type":  "string",
                                                                "description":  "是否选中"
                                                            },
                                     "paramother.categoryid":  {
                                                                   "type":  "string",
                                                                   "description":  "分类ID"
                                                               },
                                     "paramother.fromDate":  {
                                                                   "type":  "string",
                                                                   "description":  "开始日期，格式：yyyy-MM-dd"
                                                               },
                                     "paramother.toDate":  {
                                                                   "type":  "string",
                                                                   "description":  "结束日期，格式：yyyy-MM-dd"
                                                               },
                                     "currentpage":  {
                                                         "type":  "integer",
                                                         "description":  "页码，默认1"
                                                     },
                                     "pagesize":  {
                                                      "type":  "integer",
                                                      "description":  "每页数量，默认20"
                                                  }
                                 },
                      "required":  [

                                   ],
                      "response_fields":  {
                                              "sku":  "产品SKU",
                                              "name":  "产品名称",
                                              "image":  "产品图片URL",
                                              "platformname":  "平台名称",
                                              "platform_id":  "平台ID",
                                              "country":  "国家代码",
                                              "msku":  "平台SKU（如无则返回原SKU）",
                                              "warehouseid":  "仓库ID",
                                              "warehousename":  "仓库名称",
                                              "thirdparty_warehousename":  "第三方仓库名称",
                                              "quantity":  "销量合计",
                                              "price":  "销售额合计",
                                              "ship_fee":  "邮费合计",
