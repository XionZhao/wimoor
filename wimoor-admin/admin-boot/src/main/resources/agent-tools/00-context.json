{
  "module": "Agent上下文与关联关系",
  "description": "定义系统中各实体之间的关联关系、常见查询流程、字段映射规则，帮助Agent理解业务上下文并正确串联多个接口完成复杂查询",

  "entity_relations": [
    {
      "from": "店铺分组(AmazonGroup)",
      "to": "站点/国家(Marketplace)",
      "relation": "一个店铺分组下有多个站点",
      "link_field": "groupid",
      "query_tool": "amz_query_market_by_group",
      "query_param": "groupid",
      "description": "几乎所有Amazon接口都需要先获取groupid，再通过groupid获取marketplaceid"
    },
    {
      "from": "站点(Marketplace)",
      "to": "国家(Country)",
      "relation": "每个站点对应一个国家，含country代码和currency币种",
      "link_field": "marketplaceid",
      "query_tool": "amz_query_market_all",
      "output_fields": ["id", "name", "country", "currency", "market"],
      "description": "站点ID(marketplaceid)即国家站点ID，country为国家代码(如US/DE/JP)"
    },
    {
      "from": "店铺分组(AmazonGroup)",
      "to": "授权(AmazonAuthority)",
      "relation": "一个店铺分组可能有多个区域授权(如NA/EU/FE)",
      "link_field": "groupid",
      "query_tool": "amz_query_auth_id_by_group",
      "query_params": ["groupid", "marketplaceid"],
      "output_fields": ["authId"],
      "description": "部分接口需要amazonauthid而非groupid"
    },
    {
      "from": "商品(Product)",
      "to": "Listing",
      "relation": "一个商品(SPU)对应多个站点的Listing，通过ASIN关联",
      "link_field": "asin",
      "description": "商品有pid和sku，Listing有asin和msku"
    },
    {
      "from": "商品(Product)",
      "to": "FBA库存(Inventory)",
      "relation": "商品的FBA库存按SKU+站点维度存储",
      "link_field": "sku",
      "query_tool": "amz_query_fba_inventory",
      "query_params": ["sku"],
      "description": "FBA库存查询需要sku参数"
    },
    {
      "from": "商品(Product)",
      "to": "利润(Profit)",
      "relation": "商品有独立的利润计算配置和利润详情",
      "link_field": "pid",
      "query_tool": "amz_query_profit_detail",
      "query_param": "pid",
      "description": "利润查询使用pid(商品ID)，不是sku"
    },
    {
      "from": "商品(Product)",
      "to": "广告(Advertisement)",
      "relation": "广告活动按SKU/ASIN投放，广告报表关联商品",
      "link_field": "sku/asin",
      "description": "广告接口使用groupid+marketplaceid，广告报表中有sku/asin字段可关联商品"
    },
    {
      "from": "仓库(Warehouse)",
      "to": "ERP库存(Inventory)",
      "relation": "ERP库存按仓库+SKU维度存储",
      "link_field": "warehouseid",
      "query_tool": "inv_list",
      "query_param": "warehouseid",
      "description": "查询某个仓库的库存需要warehouseid"
    },
    {
      "from": "供应商(Supplier)",
      "to": "采购单(Purchase)",
      "relation": "采购单关联供应商",
      "link_field": "supplierid",
      "query_tool": "purchase_list",
      "description": "采购单中有supplierid字段"
    },
    {
      "from": "采购单(Purchase)",
      "to": "入库单(Inbound)",
      "relation": "采购单到货后生成入库单，影响ERP库存",
      "link_field": "purchaseid",
      "description": "采购单审核后可生成入库单，入库完成后库存增加"
    },
    {
      "from": "发货计划(ShipmentPlan)",
      "to": "入库Shipment(Inbound)",
      "relation": "发货计划提交Amazon后生成入库Shipment",
      "link_field": "shipmentid",
      "description": "发货计划对应Amazon的Inbound Shipment，可通过amz_query_inbound_shipment跟踪"
    },
    {
      "from": "发货计划(ShipmentPlan)",
      "to": "物流公司(TransCompany)",
      "relation": "发货计划关联物流公司和物流渠道",
      "link_field": "companyid/channelid",
      "query_tool": "shipment_plan_list",
      "description": "发货计划中有companyid和channelid字段"
    },
    {
      "from": "结算(Settlement)",
      "to": "财务(Finance)",
      "relation": "Amazon结算数据是财务记账的数据来源之一",
      "link_field": "groupid+marketplaceid+时间范围",
      "query_tool": "settlement_report",
      "description": "结算数据按月汇总，含各类费用明细"
    },
    {
      "from": "盘点(StockTaking)",
      "to": "ERP库存(Inventory)",
      "relation": "盘点完成后调整ERP库存数量",
      "link_field": "warehouseid",
      "description": "盘点单关联仓库，盘点差异会影响库存"
    },
    {
      "from": "组装单(Assembly)",
      "to": "ERP库存(Inventory)",
      "relation": "组装单消耗子件库存，产出成品库存",
      "link_field": "warehouseid",
      "query_tool": "assembly_list",
      "description": "组装单有仓库字段，执行后会影响子件和成品的库存"
    },
    {
      "from": "物料(Material)",
      "to": "采购单/库存/订单",
      "relation": "物料是ERP的核心实体，关联采购、库存、订单等多个模块",
      "link_field": "sku/materialid",
      "query_tool": "material_list",
      "description": "物料有sku编码，是贯穿ERP各模块的核心标识"
    }
  ],

  "business_domains": {
    "description": "系统分为两个独立业务域，唯一性规则和参数体系完全不同，不可混淆",
    "amazon_domain": {
      "name": "Amazon域",
      "scope": "所有 amz_ 开头的工具、settlement/shipment/advert 等工具",
      "uniqueness": "groupid + marketplaceid + sku 唯一",
      "required_params": ["groupid", "marketplaceid"],
      "param_dependency": "必须先获取groupid（amz_query_amazon_group），再获取marketplaceid（amz_query_market_by_group），才能查询业务数据",
      "key_facts": [
        "groupid = Amazon店铺分组ID，是Amazon域的核心参数",
        "marketplaceid = Amazon站点/国家ID，由groupid派生",
        "一个groupid下有多个marketplaceid（如US/DE/JP等站点）",
        "数据唯一性：groupid + marketplaceid + sku 三者组合才能唯一定位一条Amazon数据",
        "同一个SKU在不同店铺分组/站点下是不同的数据"
      ]
    },
    "erp_domain": {
      "name": "ERP域",
      "scope": "所有 erp_ 开头的工具，以及 material_/inv_/warehouse_/purchase_/shipment_ 等工具",
      "required_params": [],
      "auto_injected_params": ["shopid"],
      "param_dependency": "shopid 由系统自动注入（即客户登录上下文），用户无需手动传参",
      "uniqueness_rules": {
        "物料/商品": "shopid + sku 唯一。SKU在整个租户内唯一，贯穿ERP所有功能模块（库存、采购、发货、盘点、组装等）",
        "所有表单": "shopid + number 唯一。采购单号、入库单号、发货单号、盘点单号等表单编号都在租户内唯一"
      },
      "key_facts": [
        "shopid 是客户登录的租户上下文，由系统自动注入，用户无需关心",
        "SKU 是ERP系统的核心标识，shopid + sku 唯一定位一个物料",
        "SKU 贯穿ERP所有功能：库存(inv_list)、采购(purchase_list)、发货(shipment_plan_list)、盘点(stockTaking_list)、组装(assembly_list)等",
        "所有表单使用 shopid + number（表单编号）唯一",
        "查询物料只需传 search(SKU或名称)，shopid由系统自动注入",
        "查询ERP库存/采购/发货等不需要groupid和marketplaceid",
        "warehouseid 是ERP库存查询的仓库维度参数",
        "supplierid 是供应商维度参数"
      ]
    },
    "cross_domain": {
      "name": "跨域关联",
      "description": "Amazon商品与ERP物料通过SKU关联，Listing的msku对应ERP的SKU",
      "typical_flow": "Amazon订单中的SKU → ERP物料查询(material_list) → ERP库存(inv_list) → 采购(purchase_list)"
    }
  },

  "field_aliases": [
    {
      "description": "店铺分组ID在不同模块的字段名",
      "aliases": ["groupid", "amazongroupid", "group_id"],
      "canonical": "groupid",
      "obtained_from": "amz_query_amazon_group → id字段"
    },
    {
      "description": "站点ID在不同模块的字段名",
      "aliases": ["marketplaceid", "market", "marketplace"],
      "canonical": "marketplaceid",
      "obtained_from": "amz_query_market_by_group → id字段"
    },
    {
      "description": "国家代码",
      "aliases": ["country", "countrycode"],
      "canonical": "country",
      "obtained_from": "amz_query_market_all → country字段"
    },
    {
      "description": "币种",
      "aliases": ["currency", "tocurrency"],
      "canonical": "currency",
      "obtained_from": "amz_query_market_all → currency字段"
    },
    {
      "description": "店铺/租户ID（系统自动注入，无需手动传参）",
      "aliases": ["shopid", "companyid"],
      "canonical": "shopid",
      "obtained_from": "系统自动注入，不可由用户指定"
    },
    {
      "description": "授权ID",
      "aliases": ["amazonauthid", "authid", "auth_id"],
      "canonical": "amazonauthid",
      "obtained_from": "amz_query_auth_id_by_group(groupid, marketplaceid) → authId"
    }
  ],

  "common_flows": [
    {
      "name": "查询某店铺某站点的销售数据",
      "description": "需要先获取店铺分组ID和站点ID，再查询销售图表",
      "steps": [
        {"step": 1, "tool": "amz_query_amazon_group", "purpose": "获取groupid列表"},
        {"step": 2, "tool": "amz_query_market_by_group", "input_from_step": 1, "input_field": "groupid", "purpose": "获取该店铺下的站点列表(含marketplaceid)"},
        {"step": 3, "tool": "amz_query_chart_sales", "input_from_step": [1, 2], "input_fields": ["groupid", "marketplaceid"], "purpose": "查询销售趋势数据"}
      ]
    },
    {
      "name": "查询某商品的库存和利润",
      "description": "商品信息→FBA库存→利润详情",
      "steps": [
        {"step": 1, "tool": "amz_query_product_info_list", "purpose": "搜索商品，获取pid和sku"},
        {"step": 2, "tool": "amz_query_fba_inventory", "input_from_step": 1, "input_field": "sku", "purpose": "查询FBA库存"},
        {"step": 3, "tool": "amz_query_profit_detail", "input_from_step": 1, "input_field": "pid", "purpose": "查询利润详情"}
      ]
    },
    {
      "name": "查询发货物流状态",
      "description": "发货计划→入库Shipment跟踪",
      "steps": [
        {"step": 1, "tool": "shipment_plan_list", "purpose": "查询发货计划列表"},
        {"step": 2, "tool": "amz_query_inbound_shipment", "purpose": "跟踪Amazon入库状态"}
      ]
    },
    {
      "name": "查询财务结算数据",
      "description": "获取可用分组站点→查询结算报表",
      "steps": [
        {"step": 1, "tool": "settlement_group_market", "purpose": "获取有结算数据的分组站点组合"},
        {"step": 2, "tool": "settlement_report", "purpose": "查询月度结算汇总"},
        {"step": 3, "tool": "settlement_sku_report", "purpose": "查询SKU维度结算明细"}
      ]
    },
    {
      "name": "查询采购到入库全流程",
      "description": "采购单→入库→库存变化",
      "steps": [
        {"step": 1, "tool": "purchase_list", "purpose": "查询采购单列表"},
        {"step": 2, "tool": "purchase_detail", "input_from_step": 1, "input_field": "id", "purpose": "查看采购单详情"},
        {"step": 3, "tool": "inv_list", "purpose": "查询库存变化"}
      ]
    },
    {
      "name": "查询广告表现并关联商品",
      "description": "广告活动→广告报表→关联商品信息",
      "steps": [
        {"step": 1, "tool": "amz_query_campaign_list", "purpose": "查询广告活动列表"},
        {"step": 2, "tool": "amz_query_advert_report", "purpose": "查询广告报表(含sku/asin)"},
        {"step": 3, "tool": "amz_query_product_info_list", "purpose": "根据sku查询商品详情"}
      ]
    },
    {
      "name": "查询ERP库存并分析库存周转",
      "description": "仓库列表→库存查询→出入库记录",
      "steps": [
        {"step": 1, "tool": "warehouse_list", "purpose": "获取仓库列表和warehouseid"},
        {"step": 2, "tool": "inv_list", "input_from_step": 1, "input_field": "warehouseid", "purpose": "查询该仓库的库存"},
        {"step": 3, "tool": "inv_record_list", "purpose": "查询出入库记录"}
      ]
    },
    {
      "name": "查询商品从Listing到订单的全链路",
      "description": "商品→Listing状态→订单数据→利润",
      "steps": [
        {"step": 1, "tool": "amz_query_product_info_list", "purpose": "搜索商品"},
        {"step": 2, "tool": "amz_query_listing", "purpose": "查看Listing状态"},
        {"step": 3, "tool": "amz_query_order_list", "purpose": "查看订单数据"},
        {"step": 4, "tool": "amz_query_profit_detail", "purpose": "查看利润分析"}
      ]
    }
  ],

